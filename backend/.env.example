# ============================================================
# DEVELOPMENT (localhost)
# ============================================================
NODE_ENV=development
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=u463580331_td_db
DB_SSL=false
JWT_SECRET=dev-only-secret-change-me
CORS_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:5000

# ============================================================
# PRODUCTION (Render.com)
# ============================================================
# Set these Environment Variables in your Render Dashboard:
#
# NODE_ENV=production
# PORT=10000 (or leave empty, Render assigns PORT automatically)
#
# OPTION A: Separate MySQL Parameters (e.g. Hostinger, Aiven, Clever Cloud, Railway)
# DB_HOST=srvXXX.hstgr.io (or your cloud DB host)
# DB_PORT=3306
# DB_USER=uXXXX_td_user
# DB_PASSWORD=your_secure_db_password
# DB_NAME=uXXXX_td_db
# DB_SSL=true
#
# OPTION B: Single Connection URL (if provided by cloud provider)
# DATABASE_URL=mysql://user:password@host:3306/dbname?ssl={"rejectUnauthorized":false}
#
# Security & Origins:
# JWT_SECRET=generate_a_long_random_string_here
# CORS_ORIGIN=https://your-frontend-domain.vercel.app,http://localhost:5173
# BACKEND_PUBLIC_URL=https://td-backend.onrender.com
